<!doctype html><html lang="es"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>Voces para el dictado</title><style>
:root{--bg:#fbf8f4;--card:#fff;--ink:#2b2a33;--mute:#6b6873;--a:#7c6cf0;--a2:#e9e5ff;--g:#2f9e6f;--g2:#dff5ea;--line:#ece8f3}
@media (prefers-color-scheme:dark){:root{--bg:#1c1b22;--card:#26252e;--ink:#f1eff6;--mute:#aaa6b6;--a:#a99cff;--a2:#34305a;--g:#5fd3a0;--g2:#1f3b30;--line:#37353f}}
*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--ink);font:16px/1.5 system-ui,-apple-system,Segoe UI,Roboto,sans-serif}
main{max-width:860px;margin:0 auto;padding:24px 16px 60px}h1{font-size:1.6rem;margin:0 0 6px}p.lead{color:var(--mute);margin:0 0 20px}
.card{background:var(--card);border:1px solid var(--line);border-radius:20px;padding:18px;margin:0 0 16px}
.card h2{margin:0;font-size:1.2rem}.meta{color:var(--mute);font-size:.9rem}.lic{display:inline-block;background:var(--g2);color:var(--g);border-radius:999px;padding:2px 10px;font-size:.8rem;font-weight:600;margin-top:6px}
.row{display:flex;flex-wrap:wrap;align-items:center;gap:8px;padding:10px 0;border-top:1px solid var(--line)}.row:first-of-type{margin-top:10px}
.t{flex:1 1 220px;font-weight:600}button{border:0;border-radius:999px;padding:8px 14px;font:inherit;font-size:.9rem;cursor:pointer;min-height:40px}
.now{background:var(--a2);color:var(--a)}.slow{background:var(--g2);color:var(--g)}
.key{display:flex;gap:10px;flex-wrap:wrap;margin:0 0 18px;font-size:.9rem}.key span{border-radius:999px;padding:4px 12px}
</style></head><body><main>
<h1>Voces para el dictado (castellano)</h1>
<p class="lead">Todas son gratuitas y su licencia permite usarlas en una app con planes de pago. Cada palabra o frase se puede oír de dos maneras:</p>
<div class="key"><span class="now">🔈 Como suena hoy: grabada a ritmo normal y ralentizada por el móvil</span><span class="slow">🐢 Lenta de verdad: la voz la dice despacio, sin ralentizar</span></div>
<div id="list"></div></main><script>
const DATA = [{"name": "Davefx", "desc": "Hombre · castellano peninsular · la que se usa ahora", "lic": "CC0 (dominio público)", "rows": [{"text": "bota", "now": "data:audio/mpeg;base64,", "nowRate": 0.761, "slow": "data:audio/mpeg;base64,"}, {"text": "tren", "now": "data:audio/mpeg;base64,", "nowRate": 0.761, "slow": "data:audio/mpeg;base64,"}, {"text": "zanahoria", "now": "data:audio/mpeg;base64,", "nowRate": 0.761, "slow": "data:audio/mpeg;base64,"}, {"text": "bombilla", "now": "data:audio/mpeg;base64,", "nowRate": 0.761, "slow": "data:audio/mpeg;base64,"}, {"text": "invierno", "now": "data:audio/mpeg;base64,", "nowRate": 0.761, "slow": "data:audio/mpeg;base64,"}, {"text": "pipa", "now": "data:audio/mpeg;base64,", "nowRate": 0.761, "slow": "data:audio/mpeg;base64,"}, {"text": "Hay un yate en el mar.", "now": "data:audio/mpeg;base64,", "nowRate": 0.815, "slow": "data:audio/mpeg;base64,"}, {"text": "La hierba estaba húmeda después de la tormenta.", "now": "data:audio/mpeg;base64,", "nowRate": 0.815, "slow": "data:audio/mpeg;base64,"}, {"text": "El espectáculo fue una auténtica excepción.", "now": "data:audio/mpeg;base64,", "nowRate": 0.815, "slow": "data:audio/mpeg;base64,"}]}, {"name": "Sharvard (voz 1)", "desc": "Castellano peninsular", "lic": "CC BY 3.0 (citando la fuente)", "rows": [{"text": "bota", "now": "data:audio/mpeg;base64,", "nowRate": 0.761, "slow": "data:audio/mpeg;base64,"}, {"text": "tren", "now": "data:audio/mpeg;base64,", "nowRate": 0.761, "slow": "data:audio/mpeg;base64,"}, {"text": "zanahoria", "now": "data:audio/mpeg;base64,", "nowRate": 0.761, "slow": "data:audio/mpeg;base64,"}, {"text": "bombilla", "now": "data:audio/mpeg;base64,", "nowRate": 0.761, "slow": "data:audio/mpeg;base64,"}, {"text": "invierno", "now": "data:audio/mpeg;base64,", "nowRate": 0.761, "slow": "data:audio/mpeg;base64,"}, {"text": "pipa", "now": "data:audio/mpeg;base64,", "nowRate": 0.761, "slow": "data:audio/mpeg;base64,"}, {"text": "Hay un yate en el mar.", "now": "data:audio/mpeg;base64,", "nowRate": 0.815, "slow": "data:audio/mpeg;base64,"}, {"text": "La hierba estaba húmeda después de la tormenta.", "now": "data:audio/mpeg;base64,", "nowRate": 0.815, "slow": "data:audio/mpeg;base64,"}, {"text": "El espectáculo fue una auténtica excepción.", "now": "data:audio/mpeg;base64,", "nowRate": 0.815, "slow": "data:audio/mpeg;base64,"}]}, {"name": "Sharvard (voz 2)", "desc": "Castellano peninsular", "lic": "CC BY 3.0 (citando la fuente)", "rows": [{"text": "bota", "now": "data:audio/mpeg;base64,", "nowRate": 0.761, "slow": "data:audio/mpeg;base64,"}, {"text": "tren", "now": "data:audio/mpeg;base64,", "nowRate": 0.761, "slow": "data:audio/mpeg;base64,"}, {"text": "zanahoria", "now": "data:audio/mpeg;base64,", "nowRate": 0.761, "slow": "data:audio/mpeg;base64,"}, {"text": "bombilla", "now": "data:audio/mpeg;base64,", "nowRate": 0.761, "slow": "data:audio/mpeg;base64,"}, {"text": "invierno", "now": "data:audio/mpeg;base64,", "nowRate": 0.761, "slow": "data:audio/mpeg;base64,"}, {"text": "pipa", "now": "data:audio/mpeg;base64,", "nowRate": 0.761, "slow": "data:audio/mpeg;base64,"}, {"text": "Hay un yate en el mar.", "now": "data:audio/mpeg;base64,", "nowRate": 0.815, "slow": "data:audio/mpeg;base64,"}, {"text": "La hierba estaba húmeda después de la tormenta.", "now": "data:audio/mpeg;base64,", "nowRate": 0.815, "slow": "data:audio/mpeg;base64,"}, {"text": "El espectáculo fue una auténtica excepción.", "now": "data:audio/mpeg;base64,", "nowRate": 0.815, "slow": "data:audio/mpeg;base64,"}]}, {"name": "Carlfm", "desc": "Hombre · castellano peninsular · calidad baja", "lic": "Dominio público", "rows": [{"text": "bota", "now": "data:audio/mpeg;base64,", "nowRate": 0.761, "slow": "data:audio/mpeg;base64,"}, {"text": "tren", "now": "data:audio/mpeg;base64,", "nowRate": 0.761, "slow": "data:audio/mpeg;base64,"}, {"text": "zanahoria", "now": "data:audio/mpeg;base64,", "nowRate": 0.761, "slow": "data:audio/mpeg;base64,"}, {"text": "bombilla", "now": "data:audio/mpeg;base64,", "nowRate": 0.761, "slow": "data:audio/mpeg;base64,"}, {"text": "invierno", "now": "data:audio/mpeg;base64,", "nowRate": 0.761, "slow": "data:audio/mpeg;base64,"}, {"text": "pipa", "now": "data:audio/mpeg;base64,", "nowRate": 0.761, "slow": "data:audio/mpeg;base64,"}, {"text": "Hay un yate en el mar.", "now": "data:audio/mpeg;base64,", "nowRate": 0.815, "slow": "data:audio/mpeg;base64,"}, {"text": "La hierba estaba húmeda después de la tormenta.", "now": "data:audio/mpeg;base64,", "nowRate": 0.815, "slow": "data:audio/mpeg;base64,"}, {"text": "El espectáculo fue una auténtica excepción.", "now": "data:audio/mpeg;base64,", "nowRate": 0.815, "slow": "data:audio/mpeg;base64,"}]}, {"name": "MLS 9972", "desc": "Castellano peninsular · calidad baja", "lic": "CC BY 4.0 (citando la fuente)", "rows": [{"text": "bota", "now": "data:audio/mpeg;base64,", "nowRate": 0.761, "slow": "data:audio/mpeg;base64,"}, {"text": "tren", "now": "data:audio/mpeg;base64,", "nowRate": 0.761, "slow": "data:audio/mpeg;base64,"}, {"text": "zanahoria", "now": "data:audio/mpeg;base64,", "nowRate": 0.761, "slow": "data:audio/mpeg;base64,"}, {"text": "bombilla", "now": "data:audio/mpeg;base64,", "nowRate": 0.761, "slow": "data:audio/mpeg;base64,"}, {"text": "invierno", "now": "data:audio/mpeg;base64,", "nowRate": 0.761, "slow": "data:audio/mpeg;base64,"}, {"text": "pipa", "now": "data:audio/mpeg;base64,", "nowRate": 0.761, "slow": "data:audio/mpeg;base64,"}, {"text": "Hay un yate en el mar.", "now": "data:audio/mpeg;base64,", "nowRate": 0.815, "slow": "data:audio/mpeg;base64,"}, {"text": "La hierba estaba húmeda después de la tormenta.", "now": "data:audio/mpeg;base64,", "nowRate": 0.815, "slow": "data:audio/mpeg;base64,"}, {"text": "El espectáculo fue una auténtica excepción.", "now": "data:audio/mpeg;base64,", "nowRate": 0.815, "slow": "data:audio/mpeg;base64,"}]}, {"name": "MLS 10246", "desc": "Castellano peninsular · calidad baja", "lic": "CC BY 4.0 (citando la fuente)", "rows": [{"text": "bota", "now": "data:audio/mpeg;base64,", "nowRate": 0.761, "slow": "data:audio/mpeg;base64,"}, {"text": "tren", "now": "data:audio/mpeg;base64,", "nowRate": 0.761, "slow": "data:audio/mpeg;base64,"}, {"text": "zanahoria", "now": "data:audio/mpeg;base64,", "nowRate": 0.761, "slow": "data:audio/mpeg;base64,"}, {"text": "bombilla", "now": "data:audio/mpeg;base64,", "nowRate": 0.761, "slow": "data:audio/mpeg;base64,"}, {"text": "invierno", "now": "data:audio/mpeg;base64,", "nowRate": 0.761, "slow": "data:audio/mpeg;base64,"}, {"text": "pipa", "now": "data:audio/mpeg;base64,", "nowRate": 0.761, "slow": "data:audio/mpeg;base64,"}, {"text": "Hay un yate en el mar.", "now": "data:audio/mpeg;base64,", "nowRate": 0.815, "slow": "data:audio/mpeg;base64,"}, {"text": "La hierba estaba húmeda después de la tormenta.", "now": "data:audio/mpeg;base64,", "nowRate": 0.815, "slow": "data:audio/mpeg;base64,"}, {"text": "El espectáculo fue una auténtica excepción.", "now": "data:audio/mpeg;base64,", "nowRate": 0.815, "slow": "data:audio/mpeg;base64,"}]}, {"name": "Claude (México)", "desc": "Acento mexicano: no distingue «s» de «z/c» (seseo)", "lic": "Apache 2.0", "rows": [{"text": "bota", "now": "data:audio/mpeg;base64,", "nowRate": 0.761, "slow": "data:audio/mpeg;base64,"}, {"text": "tren", "now": "data:audio/mpeg;base64,", "nowRate": 0.761, "slow": "data:audio/mpeg;base64,"}, {"text": "zanahoria", "now": "data:audio/mpeg;base64,", "nowRate": 0.761, "slow": "data:audio/mpeg;base64,"}, {"text": "bombilla", "now": "data:audio/mpeg;base64,", "nowRate": 0.761, "slow": "data:audio/mpeg;base64,"}, {"text": "invierno", "now": "data:audio/mpeg;base64,", "nowRate": 0.761, "slow": "data:audio/mpeg;base64,"}, {"text": "pipa", "now": "data:audio/mpeg;base64,", "nowRate": 0.761, "slow": "data:audio/mpeg;base64,"}, {"text": "Hay un yate en el mar.", "now": "data:audio/mpeg;base64,", "nowRate": 0.815, "slow": "data:audio/mpeg;base64,"}, {"text": "La hierba estaba húmeda después de la tormenta.", "now": "data:audio/mpeg;base64,", "nowRate": 0.815, "slow": "data:audio/mpeg;base64,"}, {"text": "El espectáculo fue una auténtica excepción.", "now": "data:audio/mpeg;base64,", "nowRate": 0.815, "slow": "data:audio/mpeg;base64,"}]}];
const list = document.getElementById('list'); const audio = new Audio();
function play(src, rate){ audio.pause(); audio.src = src; audio.preservesPitch = true; audio.playbackRate = rate; audio.play(); }
for (const c of DATA) {
  const el = document.createElement('section'); el.className = 'card';
  el.innerHTML = `<h2>${c.name}</h2><div class="meta">${c.desc}</div><span class="lic">${c.lic}</span>`;
  for (const r of c.rows) {
    const row = document.createElement('div'); row.className = 'row';
    row.innerHTML = `<span class="t">${r.text}</span>`;
    const a = document.createElement('button'); a.className = 'now'; a.textContent = '🔈 Como hoy'; a.onclick = () => play(r.now, r.nowRate);
    const b = document.createElement('button'); b.className = 'slow'; b.textContent = '🐢 Lenta de verdad'; b.onclick = () => play(r.slow, 1);
    row.append(a, b); el.append(row);
  }
  list.append(el);
}
</script></body></html>